<resources>
    <!-- Base application theme for Android TV Digital Signage -->
    <style name="Theme.SimperTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/simper_navy_dark</item>
        <item name="android:keepScreenOn">true</item>
        <item name="colorPrimary">@color/simper_gold</item>
        <item name="colorPrimaryDark">@color/simper_navy_dark</item>
        <item name="colorAccent">@color/simper_gold</item>
    </style>
</resources>
